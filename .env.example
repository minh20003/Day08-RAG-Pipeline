# =============================================================================
# REQUIRED
# =============================================================================

# OpenRouter API Key — used for BOTH embeddings (Task 4/5) and generation (Task 10).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# =============================================================================
# EMBEDDINGS (Task 4 & 5) — defaults are fine, override only if you know why
# =============================================================================

# OpenRouter model id for the dense retriever. 1024-dim, multilingual.
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# =============================================================================
# GENERATION (Task 10) & HyDE (Task 5)
# =============================================================================

# Any OpenRouter chat model. Models ending in ":free" cost nothing but are
# limited to ~50 requests/day for the whole account.
LLM_MODEL=openai/gpt-4o-mini
# HYDE_MODEL=openai/gpt-4o-mini      # defaults to LLM_MODEL if unset

# =============================================================================
# OPTIONAL
# =============================================================================

# PageIndex (Task 8: vectorless RAG fallback). Register at https://pageindex.ai/
# Leave blank to use the built-in offline structural retriever instead.
PAGEINDEX_API_KEY=

# Jina (Task 7: cross-encoder reranking). Leave blank to use RRF only.
JINA_API_KEY=

# OpenAI API Key (fallback if OpenRouter is rate limited)
# OPENAI_API_KEY=sk-proj-...

# Gemini API Key (second fallback)
# GEMINI_API_KEY=...

# FastAPI backend / frontend integration
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHROMA_DB_PATH=chroma_db
CHROMA_COLLECTION_NAME=university_services_docs
